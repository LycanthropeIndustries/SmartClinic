// ─────────────────────────────────────────────────────────────
//  BROWSE AVAILABLE SLOTS (without booking)
// ─────────────────────────────────────────────────────────────
async function browseDoctorSlots() {
  clear();
  banner("Browse Available Slots", "Check availability for any doctor");

  let doctors = [];
  try {
    const res = await apiRequest("GET", "/doctors");
    doctors = res.data;
  } catch (err) {
    error(`Could not load doctors: ${err.message}`);
    await pressEnter();
    return;
  }

  divider("DOCTORS");
  doctors.forEach((d, i) => {
    console.log(
      `  ${C.bold}${i + 1}.${C.reset} Dr. ${d.name}${d.specialisation ? ` — ${C.dim}${d.specialisation}${C.reset}` : ""}`,
