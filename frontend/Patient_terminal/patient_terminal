async function patientMenu() {
  while (true) {
    clear();
    banner(
      `Welcome, ${session.full_name}`,
      `Patient ID: ${session.patient_id}`,
    );

    console.log(`  ${C.bold}1.${C.reset}  📅  View My Appointments`);
    console.log(`  ${C.bold}2.${C.reset}  ➕  Book an Appointment`);
    console.log(`  ${C.bold}3.${C.reset}  ❌  Cancel an Appointment`);
    console.log(`  ${C.bold}4.${C.reset}  🔍  Browse Doctor Availability`);
    console.log(`  ${C.bold}5.${C.reset}  👤  My Profile`);
    console.log(`  ${C.bold}0.${C.reset}  🚪  Log Out`);
    divider();

    const choice = (await ask(`\n  Choose an option: `)).trim();

    switch (choice) {
      case "1":
        await viewAppointments();
        break;
      case "2":
        await bookAppointment();
        break;
      case "3":
        await cancelAppointment();
        break;
      case "4":
        await browseDoctorSlots();
        break;
      case "5":
        await viewProfile();
        break;
      case "0":
        session = null;
        info("You have been logged out.");
        await pressEnter();
        return;
      default:
        warn("Invalid option. Please choose from the menu.");
        await pressEnter();
    }
  }
}

async function mainMenu() {
  while (true) {
    clear();
    banner("Welcome to SmartClinic", "Patient Self-Service Terminal");

    console.log(`  ${C.bold}1.${C.reset}  🔐  Login`);
    console.log(`  ${C.bold}2.${C.reset}  📝  Register as a New Patient`);
    console.log(`  ${C.bold}0.${C.reset}  🚪  Exit`);
    divider();

    const choice = (await ask(`\n  Choose an option: `)).trim();

    switch (choice) {
      case "1":
        await login();
        if (session) await patientMenu();
        break;
      case "2":
        await register();
        break;
      case "0":
        clear();
        console.log(
          `\n${C.cyan}Thank you for using SmartClinic. Goodbye!${C.reset}\n`,
        );
        rl.close();
        process.exit(0);
      default:
        warn("Invalid option.");
        await pressEnter();
    }
  }
}

