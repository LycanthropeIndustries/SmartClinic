  });
  console.log(`  ${C.bold}0.${C.reset} ${C.dim}← Back${C.reset}`);

  const docChoice = parseInt(await ask(`\n  Choose doctor: `));
  if (isNaN(docChoice) || docChoice === 0) return;
  if (docChoice < 1 || docChoice > doctors.length) {
    error("Invalid choice.");
    await pressEnter();
    return;
  }
  const doc = doctors[docChoice - 1];

  // Show next 5 working days
  const today = new Date();
  let allAppts = [];
  try {
    const allRes = await apiRequest("GET", "/appointments");
    allAppts = allRes.data || [];
  } catch {
    /* ignore */
  }

  const workDays = [];
  for (let d = 1; workDays.length < 5; d++) {
    const dt = new Date(today);
    dt.setDate(today.getDate() + d);
    if (dt.getDay() !== 0) workDays.push(dt);
  }

  for (const day of workDays) {
    const dateStr = day.toISOString().split("T")[0];
    const takenSlots = new Set(
      allAppts
        .filter(
          (a) =>
            a.doctor_id === doc.doctor_id &&
            a.datetime.startsWith(dateStr) &&
            !["Cancelled", "NoShow"].includes(a.status),
        )
        .map((a) => {
          const d2 = new Date(a.datetime);
          return `${String(d2.getHours()).padStart(2, "0")}:${String(d2.getMinutes()).padStart(2, "0")}`;
        }),
    );

    const timeSlots = [];
    for (let h = 8; h <= 16; h++) {
      for (let m of [0, 30]) {
        if (h === 16 && m === 30) continue;
        timeSlots.push(
          `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`,
        );
      }
    }
    const avail = timeSlots.filter((t) => !takenSlots.has(t)).length;
    const taken = takenSlots.size;

    const label = day.toLocaleDateString("en-ZA", {
      weekday: "short",
      month: "short",
      day: "numeric",
    });
    const bar = `${C.green}${"■".repeat(Math.round(avail / 2))}${C.reset}${C.red}${"■".repeat(Math.round(taken / 2))}${C.reset}`;
    console.log(
      `  ${C.bold}${label}:${C.reset} ${bar}  ${C.green}${avail} free${C.reset}, ${C.red}${taken} taken${C.reset}`,
    );
  }

  await pressEnter();
}

